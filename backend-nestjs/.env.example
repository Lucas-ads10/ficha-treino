# ==========================================
# Projeto Caverna - backend NestJS
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o .env. Em producao, use as variaveis de ambiente do Render.
# ==========================================

# Porta HTTP da API (o Render define automaticamente em producao)
PORT=

# Banco de dados MySQL (Aiven)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# TLS do MySQL (Aiven): a conexao do Prisma valida o certificado do servidor.
# A Aiven usa uma CA propria do projeto (baixe no console da Aiven).
# Informe UMA das duas opcoes:
#  - DB_SSL_CA_PATH: caminho de um arquivo .pem (desenvolvimento)
#  - DB_SSL_CA: conteudo PEM da CA (producao/Render; "\n" literal e aceito)
DB_SSL_CA_PATH=
DB_SSL_CA=

# Usada apenas pela CLI do Prisma; opcional (se vazia, e montada a partir de DB_*)
DATABASE_URL=

# Banco LOCAL sem TLS (desenvolvimento/testes). So e aceito com DB_HOST=localhost
# ou 127.0.0.1; para qualquer outro host e ignorado e o TLS continua obrigatorio.
# DB_SSL=false

# ------------------------------------------------------------------
# API / seguranca
# ------------------------------------------------------------------
# development | production. Em producao os cookies sao Secure e o CORS padrao
# passa a ser ctcaverna.com.br.
NODE_ENV=

# Frontends autorizados a chamar a API com cookies (separados por virgula).
# Padrao em producao: https://ctcaverna.com.br,https://www.ctcaverna.com.br
CORS_ORIGENS=

# URL publica do frontend (links dos e-mails). Padrao: primeira origem do CORS.
FRONTEND_URL=

# Cookie de sessao. Producao no dominio definitivo: COOKIE_DOMAIN=.ctcaverna.com.br
# COOKIE_SAMESITE: lax (padrao) | strict | none (none exige HTTPS).
COOKIE_DOMAIN=
COOKIE_SAMESITE=
# Duracao da sessao em horas (padrao: 168 = 7 dias).
SESSAO_DURACAO_HORAS=

# ------------------------------------------------------------------
# E-mail (convites e recuperacao de senha)
# ------------------------------------------------------------------
# none (padrao: nao envia; use a senha temporaria) | resend
MAIL_PROVIDER=
RESEND_API_KEY=
# Ex.: Caverna <nao-responda@ctcaverna.com.br> (dominio verificado no Resend)
MAIL_FROM=

# ------------------------------------------------------------------
# Criacao do administrador (npm run admin:criar) - opcionais, so para
# ambientes sem terminal. NAO deixe a senha gravada em arquivos.
# ------------------------------------------------------------------
# ADMIN_NOME=
# ADMIN_EMAIL=
# ADMIN_SENHA=

# NestJS Observe (opcional; gerado por "npx @nestjs/observe link")
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
